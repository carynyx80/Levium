# LEVIUM environment — copy to .env.local (never commit secrets).
# Frontend may ONLY use NEXT_PUBLIC_ values. No other-chain fallback:
# if Robinhood Chain is unreachable, the app must surface the outage,
# never silently substitute another network.

# --- Robinhood Chain (exclusive). Values from verified official docs;
# re-verify before mainnet deployment. Chain ID / RPC / explorer are
# configurable here so docs updates never require code changes.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://explorer.chain.robinhood.com
NEXT_PUBLIC_GAS_TOKEN_SYMBOL=ETH

# --- LEVIUM contract deployments (empty until deployed; UI treats empty
# as "not deployed" and disables real-money flows, never mocks them)
NEXT_PUBLIC_TOKEN_FACTORY_ADDRESS=
NEXT_PUBLIC_BONDING_CURVE_ADDRESS=
NEXT_PUBLIC_PERP_REGISTRY_ADDRESS=
NEXT_PUBLIC_COLLATERAL_VAULT_ADDRESS=
NEXT_PUBLIC_LEV_TOKEN_ADDRESS=
# Deployment block of the factory (speeds up on-chain discovery scans).
NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=
# Treasury receiving the $0.50 platform launch fee (must match on-chain feeRecipient).
NEXT_PUBLIC_TREASURY_ADDRESS=
# Official social accounts (defaults are Levium's real profiles).
NEXT_PUBLIC_X_URL=https://x.com/Leviumdotworld
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/Leviumdotworld

# --- Backend / indexer (server only — NEVER prefix with NEXT_PUBLIC_)
DATABASE_URL=
REDIS_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RPC_URL_FALLBACK=

# --- Perps safety gate. Real-money perpetual trading stays DISABLED until
# independent audits + explicit launch authorization are complete.
# "simulation" (default) | "disabled". No other value enables real money.
PERPS_MODE=simulation

# --- Admin access: comma-separated allowlist of wallet addresses.
# Enforced server-side; hiding the nav link is NOT access control.
ADMIN_WALLETS=
